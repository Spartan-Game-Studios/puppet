// TEMPLATE: adjust before use. Fill in every <PLACEHOLDER>, check every path
// against what the build actually produced (the binary name changes with the
// Puppet -> VPuppet rename), then run with steamcmd (see README.md).
// Paths are relative to this file (steam/steampipe/); "../../" is the repo root.

// Linux x86_64 depot (full). Tauri names the AppImage with the version
// (bundle/appimage/VPuppet_<VERSION>_amd64.AppImage), but the Steam launch
// option needs a fixed name, so copy it to the staging folder first:
//   mkdir -p steam/steampipe/staging/full/linux
//   cp src-tauri/target/release/bundle/appimage/VPuppet_*_amd64.AppImage \
//      steam/steampipe/staging/full/linux/VPuppet.AppImage
//   chmod +x steam/steampipe/staging/full/linux/VPuppet.AppImage
// The AppImage carries its own WebKitGTK. Inside Steam's runtime container
// FUSE may be unavailable: set the launch option's environment to
// APPIMAGE_EXTRACT_AND_RUN=1 (or pass --appimage-extract-and-run) and test.
"DepotBuild"
{
	"DepotID" "<FULL_DEPOT_ID_LINUX>"
	"ContentRoot" "../../"

	"FileMapping"
	{
		"LocalPath" "steam/steampipe/staging/full/linux/VPuppet.AppImage"
		"DepotPath" "."
	}

	// Licence files, required with every copy (MIT + third-party notices).
	"FileMapping"
	{
		"LocalPath" "LICENSE"
		"DepotPath" "."
	}
	"FileMapping"
	{
		"LocalPath" "THIRD_PARTY_NOTICES.md"
		"DepotPath" "."
	}

	// Never ship these.
	"FileExclusion" "*.pdb"
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" ".DS_Store"
}
