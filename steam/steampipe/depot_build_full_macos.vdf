// TEMPLATE: adjust before use. Fill in every <PLACEHOLDER>, check every path
// against what the build actually produced (the binary name changes with the
// Puppet -> VPuppet rename), then run with steamcmd (see README.md).
// Paths are relative to this file (steam/steampipe/); "../../" is the repo root.

// macOS depot (full): the universal (Apple silicon + Intel) VPuppet.app,
// Developer ID-signed, notarized and stapled by build-macos.sh. Upload the
// .app, not the .dmg. An Apple-silicon-only build shows "not compatible with
// macOS systems using Intel processors" on the store page.
"DepotBuild"
{
	"DepotID" "<FULL_DEPOT_ID_MAC>"
	"ContentRoot" "../../"

	// The whole bundle, recursively (includes the camera extension under
	// Contents/Helpers/VPuppet Camera.app/). The full build has no Steamworks
	// library.
	"FileMapping"
	{
		"LocalPath" "src-tauri/target/universal-apple-darwin/release/bundle/macos/VPuppet.app/*"
		"DepotPath" "VPuppet.app"
		"Recursive" "1"
	}

	// Licence files, required with every copy (MIT + third-party notices).
	"FileMapping"
	{
		"LocalPath" "LICENSE"
		"DepotPath" "."
	}
	"FileMapping"
	{
		"LocalPath" "THIRD_PARTY_NOTICES.md"
		"DepotPath" "."
	}

	// Never ship these.
	"FileExclusion" "*.pdb"
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" ".DS_Store"
}
