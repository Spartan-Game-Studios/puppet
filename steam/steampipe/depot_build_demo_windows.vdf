// TEMPLATE: adjust before use. Fill in every <PLACEHOLDER>, check every path
// against what the build actually produced (the binary name changes with the
// Puppet -> VPuppet rename), then run with steamcmd (see README.md).
// Paths are relative to this file (steam/steampipe/); "../../" is the repo root.

// Windows 64-bit depot (demo). Steam ships files, not installers: this maps
// the raw release binary and its side files, not the .msi / NSIS .exe from
// src-tauri/target-demo/release/bundle/.
// Check the file list against what an MSI install puts in Program Files.
"DepotBuild"
{
	"DepotID" "<DEMO_DEPOT_ID_WIN>"
	"ContentRoot" "../../"

	// The app. Name follows Cargo's package name; check after the rename.
	"FileMapping"
	{
		"LocalPath" "src-tauri/target-demo/release/vpuppet.exe"
		"DepotPath" "."
	}
	// Windows virtual camera (softcam) and its licence, bundled as resources
	// by tauri.windows.conf.json.
	"FileMapping"
	{
		"LocalPath" "src-tauri/target-demo/release/softcam.dll"
		"DepotPath" "."
	}
	"FileMapping"
	{
		"LocalPath" "src-tauri/target-demo/release/LICENSE-softcam.txt"
		"DepotPath" "."
	}
	// Steamworks runtime for the `steam` cargo feature. Set the path to where
	// the build puts it (or the SDK's redistributable_bin/win64/).
	"FileMapping"
	{
		"LocalPath" "src-tauri/vendor/steam/steam_api64.dll"
		"DepotPath" "."
	}

	// Licence files, required with every copy (MIT + third-party notices).
	"FileMapping"
	{
		"LocalPath" "LICENSE"
		"DepotPath" "."
	}
	"FileMapping"
	{
		"LocalPath" "THIRD_PARTY_NOTICES.md"
		"DepotPath" "."
	}

	// Never ship these.
	"FileExclusion" "*.pdb"
	"FileExclusion" "steam_appid.txt"
	"FileExclusion" ".DS_Store"
}
