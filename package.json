{
  "name": "puppet",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source webcam VTuber app: VRM avatar driven by MediaPipe face, pose and hand tracking.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "dev": "node scripts/fetch-models.mjs && vite",
    "build": "node scripts/fetch-models.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@pixiv/three-vrm": "3.5.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/three": "^0.186.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  }
}
